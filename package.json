{
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "scripts": {
  "server": "node --watch backend/server.js",
  "client": "npm run dev --prefix frontend",
  "dev": "concurrently \"npm run server\" \"npm run client\"",
  "install-all": "npm install --prefix backend && npm install --prefix frontend"
}
}
